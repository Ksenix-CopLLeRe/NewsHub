FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

RUN pip install --no-cache-dir --upgrade pip

COPY user_content_service/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY user_content_service ./user_content_service

EXPOSE 8002

CMD uvicorn user_content_service.main:app --host 0.0.0.0 --port ${PORT:-8002}
