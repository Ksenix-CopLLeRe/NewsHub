# ============================================================
# NewsHub — переменные окружения для Railway
# Скопируй нужные в Railway > Service > Variables
# ============================================================

# ── Django (news-service) ───────────────────────────────────

# Сгенерируй командой:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=your-super-secret-key-here

# false для production
DEBUG=false

# Твой домен на Railway, например: myapp.up.railway.app
DJANGO_ALLOWED_HOSTS=myapp.up.railway.app

# Нужен Django 4+ для CSRF-защиты через HTTPS
CSRF_TRUSTED_ORIGINS=https://myapp.up.railway.app

# Railway автоматически добавляет DATABASE_URL при подключении Postgres-аддона
DATABASE_URL=postgresql://user:password@host:5432/dbname

# URL-адреса микросервисов внутри Railway (приватная сеть)
# Формат: http://<service-name>.railway.internal:<port>
FEED_SERVICE_URL=http://feed-service.railway.internal:8000
REACTIONS_SERVICE_URL=http://reactions-service.railway.internal:8000
USER_CONTENT_SERVICE_URL=http://user-content-service.railway.internal:8002

USE_MICROSERVICES=true
MICROSERVICE_TIMEOUT=5.0

# ── feed-service ────────────────────────────────────────────

# Railway добавляет автоматически при подключении Postgres
DATABASE_URL=postgresql://feed_user:feed_password@host:5432/feed_db

ENVIRONMENT=production
DEBUG=false

# ── reactions-service ───────────────────────────────────────

# Railway добавляет автоматически при подключении Postgres
DATABASE_URL=postgresql://reactions_user:reactions_password@host:5432/reactions_db

DB_TYPE=postgresql

# ── user-content-service ────────────────────────────────────

# Railway добавляет автоматически при подключении Postgres
DATABASE_URL=postgresql://usercontent:usercontent@host:5432/usercontent
